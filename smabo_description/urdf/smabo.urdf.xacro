<?xml version="1.0"?>
<!--
  smabo robot model. Every configuration is the smabo base (base_link) plus
  modules picked with xacro args:

    arm:=true|false         3-DOF arm + gripper on top      (smabo_arm.xacro)
    hand:=true|false        a hand on each side             (smabo_hand.xacro)
    breadboard:=true|false  rear breadboard / PCA9685 mounts (smabo_base.xacro)
    mount:=none|tt_motor|neck
        tt_motor : mobile chassis with TT motors underneath (smabo_tt_motor.xacro)
        neck     : floor-standing pan stand that turns the base (smabo_neck.xacro)

  e.g.  xacro smabo.urdf.xacro arm:=false hand:=true breadboard:=true mount:=neck

  Meshes come from the smabo-hardware CAD (scripts/split_smabo_meshes.py).
  Joint names and limits mirror smabo-esp32 config.py (servos -90..+90 deg):
    arm_joint_1..4 (arm_joint_4 = gripper), left_hand, right_hand, head_pan,
    left/right_wheel_joint (dc.wheel_radius = 0.030 m)

  Frames: base_link is the URDF root (with mount:=neck the root is
  pan_stand_link on the floor). With mount:=tt_motor, odom -> base_link is
  published by smabo_brain_ros/odom_node, so there is deliberately no
  base_footprint parent (base_link would get two TF parents). The lidar frame is
  named `laser` to match the /scan header arriving over rosbridge.
-->
<robot name="smabo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="arm"        default="true"/>
  <xacro:arg name="hand"       default="false"/>
  <xacro:arg name="breadboard" default="false"/>
  <xacro:arg name="mount"      default="none"/>

  <xacro:include filename="$(find smabo_description)/urdf/smabo_base.xacro"/>
  <xacro:include filename="$(find smabo_description)/urdf/smabo_arm.xacro"/>
  <xacro:include filename="$(find smabo_description)/urdf/smabo_hand.xacro"/>
  <xacro:include filename="$(find smabo_description)/urdf/smabo_tt_motor.xacro"/>
  <xacro:include filename="$(find smabo_description)/urdf/smabo_neck.xacro"/>

  <xacro:smabo_base/>

  <xacro:if value="$(arg arm)">
    <xacro:smabo_arm/>
  </xacro:if>
  <xacro:if value="$(arg hand)">
    <xacro:smabo_hand/>
  </xacro:if>
  <xacro:if value="$(arg breadboard)">
    <xacro:smabo_breadboard/>
  </xacro:if>

  <xacro:if value="${'$(arg mount)' == 'tt_motor'}">
    <xacro:smabo_tt_motor/>
    <!-- LD06 lidar: TF frame only, placed on top of the base until its mount is in the CAD -->
    <link name="laser"/>
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="laser"/>
      <origin xyz="0 0 0.115" rpy="0 0 0"/>
    </joint>
  </xacro:if>
  <xacro:if value="${'$(arg mount)' == 'neck'}">
    <xacro:smabo_neck/>
  </xacro:if>

</robot>
