<?xml version="1.0"?>
<!--
  SRDF for smabo; takes the same xacro args as smabo_description/urdf/smabo.urdf.xacro
  (arm, hand, breadboard, mount) so it matches the URDF that is loaded.

  Groups: `arm` is the 3-DOF arm_joint_1..3 chain (arm_base_link -> arm_tool0,
  position-only IK, see kinematics.yaml); `gripper` is arm_joint_4 (-90 deg
  closed .. +90 deg open); `head` is head_pan (mount:=neck). The side hands
  (left_hand/right_hand) are not planned by MoveIt; they are commanded directly
  via /servo/command (smabo-web Servo tab).
-->
<robot name="smabo" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="arm"        default="true"/>
  <xacro:arg name="hand"       default="false"/>
  <xacro:arg name="breadboard" default="false"/>
  <xacro:arg name="mount"      default="none"/>
  <xacro:property name="arm"        value="$(arg arm)"/>
  <xacro:property name="hand"       value="$(arg hand)"/>
  <xacro:property name="breadboard" value="$(arg breadboard)"/>
  <xacro:property name="mount"      value="$(arg mount)"/>

  <xacro:if value="${arm}">
    <group name="arm">
      <chain base_link="arm_base_link" tip_link="arm_tool0"/>
    </group>

    <group name="gripper">
      <joint name="arm_joint_4"/>
    </group>

    <group_state name="home" group="arm">
      <joint name="arm_joint_1" value="0"/>
      <joint name="arm_joint_2" value="0"/>
      <joint name="arm_joint_3" value="0"/>
    </group_state>

    <group_state name="ready" group="arm">
      <joint name="arm_joint_1" value="0"/>
      <joint name="arm_joint_2" value="0.6"/>
      <joint name="arm_joint_3" value="0.9"/>
    </group_state>

    <group_state name="close" group="gripper">
      <joint name="arm_joint_4" value="-1.5708"/>
    </group_state>

    <group_state name="open" group="gripper">
      <joint name="arm_joint_4" value="1.5708"/>
    </group_state>

    <end_effector name="hand" parent_link="arm_link_3" group="gripper" parent_group="arm"/>

    <disable_collisions link1="base_link" link2="arm_base_link"  reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="arm_link_1"     reason="Never"/>
    <disable_collisions link1="arm_base_link" link2="arm_link_1" reason="Adjacent"/>
    <disable_collisions link1="arm_link_1" link2="arm_link_2"    reason="Adjacent"/>
    <disable_collisions link1="arm_link_2" link2="arm_link_3"    reason="Adjacent"/>
    <disable_collisions link1="arm_link_3" link2="arm_link_4"    reason="Adjacent"/>
  </xacro:if>

  <xacro:if value="${hand}">
    <disable_collisions link1="base_link" link2="hand_mount_link"        reason="Adjacent"/>
    <disable_collisions link1="hand_mount_link" link2="left_hand_link"   reason="Adjacent"/>
    <disable_collisions link1="hand_mount_link" link2="right_hand_link"  reason="Adjacent"/>
    <xacro:if value="${arm}">
      <disable_collisions link1="hand_mount_link" link2="arm_base_link"  reason="Adjacent"/>
    </xacro:if>
    <xacro:if value="${breadboard}">
      <disable_collisions link1="hand_mount_link" link2="breadboard_link" reason="Adjacent"/>
    </xacro:if>
    <xacro:if value="${mount == 'tt_motor'}">
      <disable_collisions link1="hand_mount_link" link2="chassis_link"   reason="Adjacent"/>
    </xacro:if>
    <xacro:if value="${mount == 'neck'}">
      <disable_collisions link1="hand_mount_link" link2="pan_link"       reason="Adjacent"/>
    </xacro:if>
  </xacro:if>

  <xacro:if value="${breadboard}">
    <disable_collisions link1="base_link" link2="breadboard_link"       reason="Adjacent"/>
    <xacro:if value="${arm}">
      <disable_collisions link1="breadboard_link" link2="arm_base_link" reason="Adjacent"/>
    </xacro:if>
    <xacro:if value="${mount == 'tt_motor'}">
      <disable_collisions link1="breadboard_link" link2="chassis_link"  reason="Adjacent"/>
    </xacro:if>
    <xacro:if value="${mount == 'neck'}">
      <disable_collisions link1="breadboard_link" link2="pan_link"      reason="Adjacent"/>
    </xacro:if>
  </xacro:if>

  <xacro:if value="${mount == 'tt_motor'}">
    <disable_collisions link1="base_link" link2="chassis_link"           reason="Adjacent"/>
    <disable_collisions link1="chassis_link" link2="left_wheel_link"     reason="Adjacent"/>
    <disable_collisions link1="chassis_link" link2="right_wheel_link"    reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="left_wheel_link"        reason="Never"/>
    <disable_collisions link1="base_link" link2="right_wheel_link"       reason="Never"/>
  </xacro:if>

  <xacro:if value="${mount == 'neck'}">
    <group name="head">
      <joint name="head_pan"/>
    </group>

    <group_state name="center" group="head">
      <joint name="head_pan" value="0"/>
    </group_state>

    <disable_collisions link1="pan_stand_link" link2="pan_link"  reason="Adjacent"/>
    <disable_collisions link1="pan_link" link2="base_link"       reason="Adjacent"/>
    <disable_collisions link1="pan_stand_link" link2="base_link" reason="Never"/>
  </xacro:if>

</robot>
